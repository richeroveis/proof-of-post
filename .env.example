# Copy to `.env` and fill locally. NEVER commit real values.
# `.env` is gitignored; this file contains placeholders only.

# Deployer / signer account private key (hex). Used by the GenLayer CLI and
# deploy scripts. Keep this account scoped to the authorized dev network only.
GENLAYER_PRIVATE_KEY=

# GitHub token for pushing the public repo / publishing GitHub Pages.
# Prefer a fine-grained token with the minimum required scopes.
GITHUB_TOKEN=

# Target network for deployment/verification. Studio dev ("Studio Next / dev").
GENLAYER_NETWORK=studio-dev

# Frontend build-time config (safe to expose; NEXT_PUBLIC_* is inlined).
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_GENLAYER_RPC=https://studio-dev.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
