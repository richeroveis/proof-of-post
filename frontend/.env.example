# Frontend build-time config. NEXT_PUBLIC_* values are inlined into the static
# bundle at build time and are therefore SAFE to expose (they are not secrets).
# Copy to `.env.local` for local `npm run dev`.

# Deployed RuleRegistry address on studio-dev (public value, live since
# 2026-10-09; see docs/deployment.md).
NEXT_PUBLIC_CONTRACT_ADDRESS=0x61eE31810F804E53b4Eb4A3c876F0504A1fC304b

# GenLayer Studio Dev (a.k.a. "Studio Next / dev") JSON-RPC endpoint + chain id.
NEXT_PUBLIC_GENLAYER_RPC=https://studio-dev.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997

# Base path for GitHub Pages project sites, e.g. "/proof-of-post". Leave empty
# for a user/org root site or local dev.
NEXT_PUBLIC_BASE_PATH=
