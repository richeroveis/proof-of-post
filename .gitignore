# --- Secrets / local config (NEVER commit) ---
.env
.env.*
!.env.example
*.keystore.json
*.keystore
keystores/
secrets/
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- gltest / GenLayer local artifacts ---
artifacts/
.gltest_cache/
.genlayer/
gltest.config.local.yaml
glsim.log
glsim.out
glsim.err
studio_data/
block_data/

# --- Node / Next.js frontend ---
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Scratch / one-off SDK probe dirs (never commit) ---
.tmp_*/
/deploy_out.txt
/estimate.json
/rec_*.txt
/receipt_*.txt
# browser-subagent capture scratch (root-level only); committed screenshots
# live in docs/assets/ and stay tracked
/*.png

# --- Local, token-reading setup helpers (never commit) ---
/gh_*.ps1
/setup_*.ps1

# --- Demo video production: build intermediates + raw capture media ---
# (final deliverables live in demo/output/; the raw 339 s recording and the
# per-step stills/browsers stay local only)
/demo/build/
/demo/capture/video/
/demo/capture/shots/

# --- E2E run console captures (canonical record is e2e/evidence*.json) ---
/e2e/*.log

# symlink for running e2e scripts against the frontend SDK
/e2e/node_modules
